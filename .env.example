# MongoDB (Atlas)
MONGO_URI=

# MySQL (RDS)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_SSL_CA=/app/global-bundle.pem

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Firebase
FIREBASE_RTDB_URL=
# Paste the full service account JSON on one line for Railway/production:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Disable local JSON file lookup in production (optional; non-prod auto-discovers gitignored JSON):
ALLOW_LOCAL_FIREBASE_SERVICE_ACCOUNT_FILE=
# FCM web push uses the same Firebase service account (no extra key required)

# Twilio
TWILIO_ACCOUNT_SID=
# Use LIVE Auth Token from Console (Account → API keys & tokens). Test Credentials cannot send Content Templates.
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_DELIVERY_INVITE_TEMPLATE_SID=
TWILIO_WHATSAPP_VERIFY_TEMPLATE_SID=HXf14d2adc93e9bc74745fd1472df51b23
# Template vars: {{1}} user name, {{2}} token suffix for https://www.eassymo.mx/whatsapp-verify/{{2}}
# Public URL Twilio calls for inbound WhatsApp (no trailing slash), e.g. https://api.example.com/whatsAppMessage/inbound
TWILIO_WEBHOOK_PUBLIC_URL=
# Local dev only: set to true to skip X-Twilio-Signature validation
WHATSAPP_WEBHOOK_SKIP_SIGNATURE=false
# Send a short ack when a new inbound message is stored
WHATSAPP_INBOUND_AUTO_REPLY=true
# Run GLM extraction + folio draft after inbound webhook
WHATSAPP_INTAKE_EXTRACT=true

# GLM / Z.ai (structured extraction from inbound WhatsApp)
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4/
Z_AI_MODEL=glm-5.2
# Retries on HTTP 429 (rate limit); backoff is base * 2^attempt seconds
Z_AI_MAX_RETRIES=3
Z_AI_RETRY_BASE_SECONDS=2

# App — public frontend URL for WhatsApp draft links and share links
# Local dev: http://localhost:3000 (phone testing may need ngrok instead)
CLIENT_BASE_URL=http://localhost:3000
COUNTRY_ID=484
