# MongoDB (Atlas)
MONGO_URI=

# MySQL (RDS)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_SSL_CA=/app/global-bundle.pem

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Firebase
FIREBASE_RTDB_URL=
# Paste the full service account JSON on one line for Railway/production:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Disable local JSON file lookup in production (optional; non-prod auto-discovers gitignored JSON):
ALLOW_LOCAL_FIREBASE_SERVICE_ACCOUNT_FILE=
# FCM web push uses the same Firebase service account (no extra key required)

# Local dev only: set to true to skip X-Hub-Signature-256 validation
WHATSAPP_WEBHOOK_SKIP_SIGNATURE=false
# Send a short ack when a new inbound message is stored
WHATSAPP_INBOUND_AUTO_REPLY=true
# Run GLM extraction + folio draft after inbound webhook
WHATSAPP_INTAKE_EXTRACT=true
# Seconds of silence before auto-flushing a buffered burst (also flushed with LISTO/ENVIAR)
WHATSAPP_INTAKE_QUIET_SECONDS=8
# Max seconds to keep collecting before auto-flush
WHATSAPP_INTAKE_MAX_COLLECT_SECONDS=45
# Hours without inbound before multi-store sellers must pick a tienda again
WHATSAPP_GROUP_STICKY_HOURS=12
# Seconds to debounce the "pick a tienda" WhatsApp list during a message burst
WHATSAPP_SELECTION_PROMPT_SECONDS=60

# GLM / Z.ai (structured extraction from inbound WhatsApp)
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4/
Z_AI_MODEL=glm-5.2
# Retries on HTTP 429 (rate limit); backoff is base * 2^attempt seconds
Z_AI_MAX_RETRIES=3
Z_AI_RETRY_BASE_SECONDS=2

# Meta Cloud API
# Callback URL in the app dashboard: https://<public-api-host>/whatsAppMessage/inbound
# Paste this same string into "Token de verificación", then click Verificar y guardar.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
# Fallback language when a send does not set template.language
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Team invite (es_MX): body {{1}} group name, URL button {{1}} invite id
WHATSAPP_TEMPLATE_TEAM_INVITE=eassymo_team_invite
# Provider invite (es_MX): body inviting group, invited business, pending count; URL button census id
WHATSAPP_TEMPLATE_NETWORK_INVITE=eassymo_provider_invite
# POS binder (en): body {{1}} user name, URL button {{1}} verification token
WHATSAPP_TEMPLATE_VERIFY=wp_eassymo_verification_binder
# Leave empty: guest delivery uses Cloud API freeform text, not eassymo_courier_invite
WHATSAPP_TEMPLATE_DELIVERY_INVITE=

# App — public frontend URL for WhatsApp draft links and share links
# Local dev: http://localhost:3000 (phone testing may need ngrok instead)
CLIENT_BASE_URL=https://your-frontend-url.vercel.app
# Optional HTTPS base used only in WhatsApp chat links (overrides CLIENT_BASE_URL).
# Local + free ngrok: use dev/whatsapp-local-proxy (:8080) + `ngrok http 8080` — see dev/whatsapp-local-proxy/README.md
WHATSAPP_PUBLIC_BASE_URL=
COUNTRY_ID=484
